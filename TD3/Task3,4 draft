#include "mbed.h"

AnalogIn A(PA_0);
AnalogIn B(PA_1);
AnalogIn C(PA_4);
AnalogIn D(PB_0);
AnalogIn E(PC_1);
AnalogIn F(PC_0);

//----------------------之前预设好的PWM参数---------------------//
PwmOut pwmL(PC_8);
PwmOut pwmR(PC_6);
DigitalOut enable(PC_4);
DigitalOut dirL(PA_12);// Direction only (no bipolar control pin)
DigitalOut dirR(PB_12);
float PWM_FREQ_HZ = 20000.0f; // 20 kHz

//-----------------------P control------------------------//
float Kp = 1; //???不知道是多少
float last_position = 0.0f;


//---------------------由Control system控制的函数-------------------//
void SetMotor(float rightpwm, float leftpwm){
    pwmL.write(leftpwm);
    pwmR.write(rightpwm);
}

void StopMotor(){
    pwmL.write(0.5);
    pwmR.write(0.5);
}

