//----------------------白线和黑线的偏差是error---------------------//
float Calculate_position(){//error
    float a = A.read();
    float b = B.read();
    float c = C.read();
    float d = D.read();
    float e = E.read();
    float f = F.read();
    float sum = a+b+c+d+e+f;

    if (sum < 0.0001f) {
        return 0.0f; // 如果全白（或全黑），直接返回 0，避免除以0
    }

    // A:-3  B:-2  C:-1  whiteline:0  D:1  E:2  F:3
    float position = (a*(-3)+b*(-2)-c+d+2*e+3*f)/sum;
    return position;
}

int main() {
// PWM frequency
    pwmL.period(1.0f / PWM_FREQ_HZ);
    pwmR.period(1.0f / PWM_FREQ_HZ);
    // bipolar
    dirL = 1;
    dirR = 1;
    enable = 1;

    float referpwm = 0.35;

    float startup = 0.0f;
    while(startup < referpwm) {
    startup += 0.01f;
    pwmL.write(startup);
    pwmR.write(startup);
    wait_ms(20);
}
    
    //------------------------修正方向------------------------//
    while(1){
        float a = A.read();
        float b = B.read();
        float c = C.read();
        float d = D.read();
        float e = E.read();
        float f = F.read();

        float sum = a+b+c+d+e+f;
        float position = last_position;
        float correction = 0.0f;

    //丢线处理
        if (sum < 0.01f) {
            if (last_position < 0) {
            correction = -0.1f;//向左找
            }
            else if (last_position > 0) {
            correction = 0.1f;//向右找
            }
            else {
            correction = 0.0f;
            }
        }
        else{
            position = Calculate_position();
            correction = Kp * position;
        }

        float leftpwm =  referpwm + correction;
        float rightpwm = referpwm - correction;

        SetMotor(rightpwm, leftpwm);

        last_position = position;
        wait_ms(5);
    }
}
