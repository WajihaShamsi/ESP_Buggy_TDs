//----------------------白线和黑线的偏差是error---------------------//
float Calculate_position(){//error
    float a = sensVAL[0];
    float b = sensVAL[1];
    float c = sensVAL[2];
    float d = sensVAL[3];
    float e = sensVAL[4];
    float f = sensVAL[5];
    float sum = a+b+c+d+e+f;

    if (sum < 0.0001f) {
        return 0.0f; // 如果全白（或全黑），直接返回 0，避免除以0
    }

    // A:-3  B:-2  C:-1  whiteline:0  D:1  E:2  F:3
    float position = (a*(-3.5)+b*(-2)-c+d+2*e+3.5*f)/sum;
    return position;
}

