//---------------------归一化函数--------------------//
float sensMAX[6] = {0,0,0,0,0,0};
float sensMIN[6] = {1,1,1,1,1,1};
float sensVAL[6] = {0,0,0,0,0,0};

void normalised(){
    float raw[6];
    raw[0] = A.read();
    raw[1] = B.read();
    raw[2] = C.read();
    raw[3] = D.read();
    raw[4] = E.read();
    raw[5] = F.read();

    //更新黑白数据,求出归一化的sensor value
    for (int i = 0; i < 6; i++) {

        if (raw[i] < sensMIN[i]) {
        sensMIN[i] = raw[i];
        }
        if (raw[i] > sensMAX[i]) {
        sensMAX[i] = raw[i];
        }

        //归一化公式
        float range = sensMAX[i] - sensMIN[i];
        if (range > 0.0001f) {
        sensVAL[i] = (raw[i] - sensMIN[i])/range;
        }
        else {sensVAL[i] = 0;}
        
        if (sensVAL[i] < 0.0f) {sensVAL[i] = 0;}
        if (sensVAL[i] > 1.0f) {sensVAL[i] = 1;}
    }
}


//---------------------由Control system控制的函数-------------------//
void SetMotor(float rightpwm, float leftpwm){
    if (leftpwm > 0.5f) leftpwm = 0.5f;
    if (leftpwm < 0.0f) leftpwm = 0.0f;
    if (rightpwm > 0.5f) rightpwm = 0.5f;
    if (rightpwm < 0.0f) rightpwm = 0.0f;

    pwmL.write(leftpwm);
    pwmR.write(rightpwm);
}

void StopMotor(){
    pwmL.write(0.5);
    pwmR.write(0.5);
}

