% Configuration
port = "COM7"; 
baudrate = 115200;
maxTime = 120 % Run for 30 seconds

device = serialport(port, baudrate);
flush(device);

figure('Name', 'Mbed Motor Velocity Control');
h1 = animatedline('Color', 'r', 'LineWidth', 1.5); 
h2 = animatedline('Color', 'b', 'LineWidth', 1);   
h3 = animatedline('Color', 'g', 'LineWidth', 1);   
legend('Target', 'Left Velocity', 'Right Velocity');
xlabel('Time (seconds)'); % Changed label
ylabel('Speed (m/s)');
grid on;

disp('Starting data collection...');
startTime = tic; % Start the stopwatch
currentTime = 0;

while currentTime < maxTime
    currentTime = toc(startTime); % Get elapsed time since startTime
    
    dataStr = readline(device);
    if strlength(dataStr) > 0
        data = str2num(dataStr);
        if length(data) == 3
            % Use currentTime for the X-axis instead of 'i'
            addpoints(h1, currentTime, data(1));
            addpoints(h2, currentTime, data(2));
            addpoints(h3, currentTime, data(3));
            drawnow limitrate;
        end
    end
end
