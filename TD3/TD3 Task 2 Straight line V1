#include "mbed.h"                                          //Imports mbed libraries
#include "C12832.h"                                     //Imports the library for the LCD screen
C12832 lcd(D11, D13, D12, D7, D10);       //Creates an LCD Object from the LCD library
PwmOut pwmL(PC_8); //Left motor PWM
PwmOut pwmR(PC_6); //Right motor PWM

AnalogIn sensors[6] = {A0, A1, A2, A3, A4, A5}; //declaring the sensors 
DigitalOut ir_pwr(D2); // Pin that turns the sensor LEDs on/off
float clean_values[6]; // Array for values after subtracting ambient light 

// Finite State Machine States
enum State {FOLLOWING, LOST, STOPPED};
State current_state = FOLLOWING;

// Global target speeds determined for the PID Loop
volatile float target_speed_L = 0.0f;
volatile float target_speed_R = 0.0f;

// Tuning Constants (start by getting the buggy to oscilate regularily)
float Kp = 1.0f;   // How aggressively the buggy turns
float Ki = 0.0f;   // Usually 0 for straight line tests
float Kd = 0.0f;   // "The Brakes" - prevents wobbling/oscillations

// Control Variables
float error_val = 0.0f;
float last_error = 0.0f;
float integral = 0.0f;
float derivative = 0.0f;
float correction = 0.0f;

float base_speed = 0.4f; // Target speed (0.0 to 1.0)
int lost_counter = 0;    // Counter to track how long line is missing

//Code declaring all pins for motors, encoders
//add code to maintain motor speed

//Helper function to keep PWM between 0.0 and 1.0 (prevents Mbed crashes)
float constrain(float value) {
    if(value < 0.0f) return 0.0f;
    if(value > 1.0f) return 1.0f;
    return value;
}

void speed_control() { //re
    //  0.5 = Stop, 0.0 = Full Forward, 1.0 = Full Reverse
    // PWM output based on the target speeds from the PID loop
    float outL = 0.5f - target_speed_L; 
    float outR = 0.5f - target_speed_R;

    // Apply the values to the PWM pins
    pwmL = constrain(outL);
    pwmR = constrain(outR);
}

class LED {
protected: 
    DigitalOut outputSignal; // Declaration of DigitalOut
    bool status;             // Variable to recall the state of the LED
public: 
    // Constructor - user provided pin name is assigned to the DigitalOut
    LED(PinName pin) : outputSignal(pin) {off();}
    // Public member function for turning the LED on
    void on(void) {
        outputSignal = 0;    // Set output to 0 (LED is active low)
        status = true;       // Set the status variable to show the LED is on
    }
    // Public member function for turning the LED off
    void off(void) {
        outputSignal = 1;    // Set output to 1 (LED is active low)
        status = false;      // Set the status variable to show the LED is off
    }
    // Getter for the current status
    bool getStatus(void) {
        return status;
    }
};

LED redLED(D5); //Declare LED object for red
LED blueLED(D8); //Declare LED object for blue
LED greenLED(D9); //Declare LED object for green

void clean_sensor_reading() {
    float ambient[6];
    float active[6];

    //read ambient (LEDs OFF)
    ir_pwr = 0;
    wait_us(50); // Small delay for LEDs to fully turn off
    for(int i=0; i<6; i++) ambient[i] = sensors[i].read(); //read sensors 

    //read active (LEDs ON)
    ir_pwr = 1;
    wait_us(50); // Small delay for LEDs to stabilize
    for(int i=0; i<6; i++) active[i] = sensors[i].read();

    //subtract ambient
    for(int i=0; i<6; i++) {
        clean_values[i] = active[i] - ambient[i];
        if(clean_values[i] < 0) clean_values[i] = 0; // NEED SOME MEASURE if ambient light reading is brighter? just negate that reading
    }
}

float calculate_error() {
    float weighted_sum = 0;
    float total_signal = 0;
    float weights[6] = {-2.5, -1.5, -0.5, 0.5, 1.5, 2.5};
    
    float threshold = 0.1f; // Adjust this based threashold value on white after normalised by ADC
    bool line_detected = false;

    for(int i=0; i<6; i++) {
        if(clean_values[i] > threshold) {
            line_detected = true;
        }
        weighted_sum += clean_values[i] * weights[i];
        total_signal += clean_values[i];
    }
    
    // Check for line presence 
    if(!line_detected || total_signal == 0) {
        current_state = LOST; 
        return last_error; // Continue using the last direction known
    }
    
    current_state = FOLLOWING;
    lost_counter = 0; 
    return weighted_sum / total_signal;
}

void pid_control_loop() {
    clean_sensor_reading(); 
    error_val = calculate_error(); 

    switch(current_state) {
        case FOLLOWING:
            greenLED.on();
            blueLED.off();
            redLED.off();

            integral += error_val;
            derivative = error_val - last_error;
            correction = (error_val * Kp) + (integral * Ki) + (derivative * Kd);
            last_error = error_val;
            
            target_speed_L = base_speed + correction;
            target_speed_R = base_speed - correction;
            break;

        case LOST:
            // LED Indication: Blue for searching/lost
            greenLED.off();
            blueLED.on();
            redLED.off();

            lost_counter++;
            if (lost_counter <= 3) {
                target_speed_L = base_speed + correction;
                target_speed_R = base_speed - correction;
            } 
            else {
                //flip the correction sign and slow down to 60% speed 
                // Slowing down helps the sensors "catch" the line better
                target_speed_L = (base_speed * 0.6f) - correction; 
                target_speed_R = (base_speed * 0.6f) + correction;
            }
            //Give up after 2 seconds (100 cycles)
            if (lost_counter > 100) current_state = STOPPED;
            break;

        case STOPPED:
            // LED Indication: Red for emergency stop
            greenLED.off();
            blueLED.off();
            redLED.on();

            target_speed_L = 0.0f;
            target_speed_R = 0.0f;
            break;
    }
}

Ticker line_ticker;  // PID Loop
Ticker speed_ticker; // PI Speed Loop

int main() {
    //change these values based on calculations
    // line_ticker runs at 0.02s (50Hz)
    line_ticker.attach(&pid_control_loop, 0.02); 
    // motor_ticker runs at 0.005s (200Hz) to check speed 4x more often
    speed_ticker.attach(&speed_control, 0.005);    
    
    while(1) {
        lcd.cls();
        lcd.locate(0,0);
        lcd.printf("Targets: L:%.2f R:%.2f", target_speed_L, target_speed_R);
        if(current_state == FOLLOWING) lcd.printf("State: FOLLOWING");
        else if(current_state == LOST) lcd.printf("State: LOST");
        else lcd.printf("State: STOPPED");
        
        lcd.locate(0,10);
        lcd.printf("Err: %.2f", error_val);
        wait_ms(100); // to prevent flickering 
    }
}
