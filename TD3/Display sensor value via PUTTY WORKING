#include "mbed.h"

Serial pc(USBTX, USBRX);
AnalogIn sensors[4] = {A2, A3, A4, A5};
float weight [4]={-2,-1,1,2};


int main() {
    pc.baud(9600);
    

    while (1) {
        pc.printf("Sensors: ");
        float total=0.0f;
        for (int i = 0; i < 4; i++) {
            float val = sensors[i].read(); // 0.0 → 1.0
            total= total + val*weight[i];
            pc.printf("S%d:%.3f ", i, val);
        }

        pc.printf("\r\n");
        pc.printf("Total:%.3f ", total);
        wait(0.5); // 500 ms
    }
}
