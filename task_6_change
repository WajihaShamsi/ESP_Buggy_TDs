#include "mbed.h"
#include "QEI.h"


/*--------------------------Constants--------------------------*/
int PPR = 256;
int GEAR_RATIO = 15;
float WHEEL_RADIUS = 0.0394f; // m
float PI = 3.1415926f;
float PWM_FREQ_HZ = 20000.0f; // 20 kHz
/*
256*4 = 1024 counts per motor revolution. 
1024*15 = 15350 counts per wheel revolution. 
Distance per wheel revolution = 2pir = 0.2475. 
0.5/0.2475 = 200/99 required wheel revolutions. 
15360*200/9 = 31030 required counts.
*/
int COUNTS_PER_MOTOR_REV = PPR * 4;
int COUNTS_PER_WHEEL_REV = COUNTS_PER_MOTOR_REV * GEAR_RATIO;

float WHEEL_CIRC = 2.0f * PI * WHEEL_RADIUS; // ~0.2475 m
float COUNTS_PER_M = (float)COUNTS_PER_WHEEL_REV / WHEEL_CIRC;
// 0.5 m target
int COUNTS_0_5M = (int)(0.5f * COUNTS_PER_M);
int TURN_COUNTS = 6800; // idk some number

int TURN_90_TICKS  = 6800;    //Change
int TURN_180_TICKS = 2 * TURN_90_TICKS;

//PWM duty values
float DUTY_FWD  = 0.45f;
float DUTY_TURN = 0.40f;
// If your driver PWM input is inverted/active-low, set this true
bool PWM_INVERTED = false;

/*--------------------------Setting Output Pins--------------------------*/

PwmOut pwmL(D9);
PwmOut pwmR(D10);

DigitalOut enable(D8, 0);
DigitalOut dirL(D7, 1);
DigitalOut dirR(D6, 1);
DigitalOut bipolarL(D5, 0);
DigitalOut bipolarR(D4, 0);

// Encoders
QEI left_encoder(PA_6, PA_7, NC, PPR, QEI::X4_ENCODING);
QEI right_encoder(PB_6, PB_7, NC, PPR, QEI::X4_ENCODING);

/*--------------------------Helper Functions--------------------------*/

static inline float clampf(float x, float lo, float hi) {
    if (x < lo) return lo;
    if (x > hi) return hi;
    return x;
}

void writePWM(PwmOut &pwm, float duty) {
    duty = clampf(duty, 0.0f, 1.0f);
    if (PWM_INVERTED) duty = 1.0f - duty;
    pwm.write(duty);
}

void setLeftMotor(float duty, bool forward) {
    dirL = forward ? 1 : 0;
    writePWM(pwmL, duty);   // note: if board is inverted logic, you may need (1.0f - duty)
}

void setRightMotor(float duty, bool forward) {
    dirR = forward ? 1 : 0;
    writePWM(pwmR, duty);
}

void stopMotors() {
    writePWM(pwmL, 0.0f);
    writePWM(pwmR, 0.0f);
}

int avgAbsTicks() {
    int l = abs(left_encoder.getPulses());
    int r = abs(right_encoder.getPulses());
    return (l + r) / 2;
}

// Drive forward for a target encoder count
void driveForwardTicks(float duty, int target_ticks) {
    left_encoder.reset();
    right_encoder.reset();

    setLeftMotor(duty, true);
    setRightMotor(duty, true);

    while (true) {
        if (avgAbsTicks() >= target_ticks) break;
    }

    stopMotors();
    ThisThread::sleep_for(200ms);
}

// Pivot right: left wheel moves, right wheel stopped
void turnRightPivotTicks(float duty, int target_ticks) {
    left_encoder.reset();
    right_encoder.reset();

    setLeftMotor(duty, true);
    setRightMotor(0.0f, true);

    while (true) {
        int ticks = abs(left_encoder.getPulses());
        if (ticks >= target_ticks) break;
    }

    stopMotors();
    ThisThread::sleep_for(200ms);
}

/*--------------------------FSM--------------------------*/
enum State {
    START,
    FWD_SIDE,
    TURN_LEFT_90,
    FWD_STOP_AT_START,
    TURN_180,
    REV_SIDE,
    TURN_LEFT_90_REV,
    DONE
};

State state = START;

int side_count = 0;       // 0..3 for forward square
int rev_side_count = 0;   // 0..3 for reverse square

/*--------------------------Main--------------------------*/

int main()
{
        // PWM frequency
    pwmL.period(1.0f / PWM_FREQ_HZ);
    pwmR.period(1.0f / PWM_FREQ_HZ);

    // unipolar
    bipolarL = 0;
    bipolarR = 0;

    enable = 1;
    ThisThread::sleep_for(500ms);

    // Start “run without intervention”
    left_encoder.reset();
    right_encoder.reset();

    while (true) {

        switch (state) {

            case START: {
                side_count = 0;
                rev_side_count = 0;
                left_encoder.reset();
                right_encoder.reset();
                state = FWD_SIDE;
                break;
            }

            // ---------- Forward square ----------
            case FWD_SIDE: {
                setLeftMotor(DUTY_FWD, true);
                setRightMotor(DUTY_FWD, true);

                if (avgAbsTicks() >= COUNTS_0_5M) {
                    stopMotors();
                    ThisThread::sleep_for(150ms);
                    left_encoder.reset();
                    right_encoder.reset();
                    state = TURN_LEFT_90;
                }
                break;
            }

            case TURN_LEFT_90: {
                // Turn left in place: left backward, right forward
                setLeftMotor(DUTY_TURN, false);
                setRightMotor(DUTY_TURN, true);

                // Use average ticks so it works even if one wheel slips a bit
                if (avgAbsTicks() >= TURN_90_TICKS) {
                    stopMotors();
                    ThisThread::sleep_for(150ms);
                    left_encoder.reset();
                    right_encoder.reset();

                    side_count++;

                    if (side_count >= 4) {
                        // Finished forward square: we should be back near start
                        state = FWD_STOP_AT_START;
                    } else {
                        state = FWD_SIDE;
                    }
                }
                break;
            }

            case FWD_STOP_AT_START: {
                // Just a clean stop state (already stopped)
                stopMotors();
                ThisThread::sleep_for(250ms);
                left_encoder.reset();
                right_encoder.reset();
                state = TURN_180;
                break;
            }

            // ---------- Turn around ----------
            case TURN_180: {
                // Turn 180: same as two 90s
                setLeftMotor(DUTY_TURN, false);
                setRightMotor(DUTY_TURN, true);

                if (avgAbsTicks() >= TURN_180_TICKS) {
                    stopMotors();
                    ThisThread::sleep_for(150ms);
                    left_encoder.reset();
                    right_encoder.reset();
                    state = REV_SIDE;
                }
                break;
            }

            // ---------- Reverse square ----------
            case REV_SIDE: {
                // Reverse direction (drive backward)
                setLeftMotor(DUTY_FWD, false);
                setRightMotor(DUTY_FWD, false);

                if (avgAbsTicks() >= COUNTS_0_5M) {
                    stopMotors();
                    ThisThread::sleep_for(150ms);
                    left_encoder.reset();
                    right_encoder.reset();
                    state = TURN_LEFT_90_REV;
                }
                break;
            }

            case TURN_LEFT_90_REV: {
                // While reversing square, keep same “turn left” relative to chassis:
                // still rotate the chassis left using same in-place turn
                setLeftMotor(DUTY_TURN, false);
                setRightMotor(DUTY_TURN, true);

                if (avgAbsTicks() >= TURN_90_TICKS) {
                    stopMotors();
                    ThisThread::sleep_for(150ms);
                    left_encoder.reset();
                    right_encoder.reset();

                    rev_side_count++;

                    if (rev_side_count >= 4) {
                        state = DONE;
                    } else {
                        state = REV_SIDE;
                    }
                }
                break;
            }

            case DONE: {
                stopMotors();
                while (true) { ThisThread::sleep_for(1s); }
            }
        }
    }
}
