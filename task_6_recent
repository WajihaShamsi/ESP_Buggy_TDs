/*--------------------------FSM--------------------------*/
enum State {
    START,
    FWD_SIDE,
    TURN_LEFT_90,
    FWD_STOP_AT_START,
    TURN_180,
    REV_SIDE,
    TURN_LEFT_90_REV,
    ONE_MORE,
    DONE
};

State state = START;

int side_count = 0;       // 0..3 for forward square
int rev_side_count = 0;   // 0..3 for reverse square

/*--------------------------Main--------------------------*/

int main()
{
        // PWM frequency
    pwmL.period(1.0f / PWM_FREQ_HZ);
    pwmR.period(1.0f / PWM_FREQ_HZ);

    // bipolar
    dirL = 1;
    dirR = 1;

    enable = 1;

    left_encoder.reset();
    right_encoder.reset();

    while (true) {

        switch (state) {

            case START: {
                side_count = 0;
                rev_side_count = 0;
                left_encoder.reset();
                right_encoder.reset();
                state = FWD_SIDE;
                break;
            }

            // ---------- Forward square ----------
            case FWD_SIDE: {
                setLeftMotor(0.3f);
                setRightMotor(0.3f);

                if (avgAbsTicks() >= COUNTS_0_5M) {
                    stopMotors();
                    left_encoder.reset();
                    right_encoder.reset();
                    wait_ms(200);
                    state = TURN_LEFT_90;
                    //state = DONE;
                }
                break;
            }

            case TURN_LEFT_90: {
                // Turn left in place: left backward, right forward
                setLeftMotor(0.35f);
                setRightMotor(0.65f);

                // Use average ticks so it works even if one wheel slips a bit
                if (avgAbsTicks() >= COUNTS_RIGHT_1/2) {
                    stopMotors();
                    left_encoder.reset();
                    right_encoder.reset();
                    wait_ms(200);

                    side_count++;

                    if (side_count >= 3) {
                        // Finished forward square: we should be back near start
                        state = FWD_STOP_AT_START;
                    } else {
                        state = FWD_SIDE;
                    }
                }
                break;
            }

            case FWD_STOP_AT_START: {
                setLeftMotor(0.3f);
                setRightMotor(0.3f);

                if (avgAbsTicks() >= COUNTS_0_5M) {
                    stopMotors();
                    left_encoder.reset();
                    right_encoder.reset();
                    wait_ms(200);
                    state = TURN_180;
                    //state = DONE;
                }
                break;
            }

            // ---------- Turn around ----------
            case TURN_180: {
                // Turn 180: same as two 90s
                setLeftMotor(0.35f);
                setRightMotor(0.65f);

                if (avgAbsTicks() >= COUNTS_180) {
                    stopMotors();
                    left_encoder.reset();
                    right_encoder.reset();
                    wait_ms(200);
                    state = REV_SIDE;
                }
                break;
            }

            // ---------- Reverse square ----------
            case REV_SIDE: {
                // Reverse direction (drive backward)
                setLeftMotor(0.3f);
                setRightMotor(0.3f);

                if (avgAbsTicks() >= COUNTS_0_5M) {
                    stopMotors();
                    left_encoder.reset();
                    right_encoder.reset();
                    wait_ms(200);
                    state = TURN_LEFT_90_REV;
                }
                break;
            }

            case TURN_LEFT_90_REV: {
                // While reversing square, keep same “turn left” relative to chassis:
                // still rotate the chassis left using same in-place turn
                setLeftMotor(0.65f);
                setRightMotor(0.35f);

                if (avgAbsTicks() >= COUNTS_RIGHT_1/2.1) {
                    stopMotors();
                    left_encoder.reset();
                    right_encoder.reset();
                    wait_ms(200);

                    rev_side_count++;

                    if (rev_side_count >= 3) {
                        state = ONE_MORE;
                    } else {
                        state = REV_SIDE;
                    }
                }
                break;
            }

            case ONE_MORE: {
                // Reverse direction (drive backward)
                setLeftMotor(0.3f);
                setRightMotor(0.3f);

                if (avgAbsTicks() >= COUNTS_0_5M) {
                    stopMotors();
                    left_encoder.reset();
                    right_encoder.reset();
                    wait_ms(200);
                    state = DONE;
                }
                break;
            }
              case DONE: {
                stopMotors();
                while (true) { }
            }
        }
    }
}
